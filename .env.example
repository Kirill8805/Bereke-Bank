# =====================================================================
#  Bereke AI — пример переменных окружения.
#  Скопируйте этот файл в .env и подставьте значения из вашего
#  нового проекта Supabase (Project Settings → API).
# =====================================================================

# --- Supabase: публичные значения (видны и на клиенте) ---
# Берутся из Supabase → Project Settings → API
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# --- Supabase: те же значения для сервера (SSR) ---
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# --- Supabase: СЕКРЕТНЫЙ ключ сервера (обходит RLS). НЕ показывать клиенту! ---
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=""

# --- ИИ (для тренажёров-чатов) ---
# Вариант A (рекомендуется при переезде): оставьте LOVABLE_API_KEY пустым,
#   а ключ OpenAI введите в админ-панели приложения (сохранится в app_settings,
#   модель gpt-4o-mini). Тогда эта переменная не нужна.
# Вариант B: если у вас есть доступ к шлюзу Lovable — впишите его ключ сюда.
LOVABLE_API_KEY=""
